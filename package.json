{
  "name": "@awesome-os/dotnet",
  "version": "0.1.0",
  "description": "Zero-installer native 4-OS C11 .NET SDK launcher hydrating rolling-latest .NET from awesome-os/b8g-ghost cas-v1 (Keep-Last-5, zero 1 GB installer bloat)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/awesome-os/dotnet.git"
  },
  "awesomeOs": {
    "casRegistry": "https://raw.githubusercontent.com/awesome-os/b8g-ghost/main/manifests/index.json",
    "casRelease": "cas-v1",
    "retentionPolicy": "keep-last-5",
    "keys": {
      "win64": "dotnet-sdk-win64.tar.zst",
      "linux-x64": "dotnet-sdk-linux-x64.tar.zst",
      "linux-arm64": "dotnet-sdk-linux-arm64.tar.zst",
      "macos-arm64": "dotnet-sdk-macos-arm64.tar.zst"
    },
    "env": {
      "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
    }
  }
}
